<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ARPG</AssemblyName>
    <RootNamespace>ARPG</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.2.1105" />
    <PackageReference Include="LiteNetLib" Version="1.2.0" />
    <PackageReference Include="FontStashSharp.MonoGame" Version="1.3.9" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Data/**/*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Content/**/*.ttf" CopyToOutputDirectory="PreserveNewest" />
    <!-- Drop-in art/audio assets (e.g. Assets/Sounds/*.wav) ride along verbatim. -->
    <None Include="Assets/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
